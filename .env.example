# THRIFTR environment variables
#
# Copy this file to `.env.local` for local development.
# Do not commit `.env.local` to GitHub.

# Supabase browser client values.
# Get these from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Edge Function secrets.
# These do not go in `.env.local`; set them in Supabase Dashboard -> Edge Functions -> Secrets
# or with `supabase secrets set ...`.
#
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=your-safaricom-paybill
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://your-project-id.supabase.co/functions/v1/mpesa/callback
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# UBER_CLIENT_ID=
# UBER_CLIENT_SECRET=
# AT_API_KEY=
# AT_USERNAME=
